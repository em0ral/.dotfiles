# Added by OrbStack: 'orb' SSH host for Linux machines
# This only works if it's at the top of ssh_config (before any Host blocks).
# This won't be added again if you remove it.
Include ~/.orbstack/ssh/config

# btc-node: the 2018 Intel mini (i7-8700B, 64 GB), macOS + OrbStack, managed from the M5.
# Also the transport for `docker --context btc-node` (docker runs `ssh btc-node docker system dial-stdio`).
Host btc-node
  HostName btc-node.local
  User em0ral
  IdentityFile ~/.ssh/id_ed25519_agentiv
  IdentitiesOnly yes
  ServerAliveInterval 15
  ServerAliveCountMax 8

# Keep sessions alive through short Wi-Fi drops (mesh roaming, satellite restarts).
Host *
  ServerAliveInterval 15
  ServerAliveCountMax 8
